# ============================================
# Family Office - Environment Configuration
# ============================================
# Copy to .env and fill in your actual keys

# LLM Provider
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...

# Market Data APIs
ALPHA_VANTAGE_API_KEY=your_key_here
FRED_API_KEY=your_key_here

# Dashboard
DASHBOARD_HOST=0.0.0.0
DASHBOARD_PORT=8000
DASHBOARD_SECRET_KEY=change-this-to-random-secret

# Database
DATABASE_URL=sqlite+aiosqlite:///./family_office.db

# Logging
LOG_LEVEL=INFO
